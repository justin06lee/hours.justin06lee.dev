# Template of the variable NAMES this app needs. No secrets here — .gitignore
# ignores every .env* except this one, precisely so the shape can be committed
# while the values never are. Copy to .env.local and fill in.
#
# All four are required in production. See the Environment table in README.md.

# libsql connection, used by src/lib/db.ts.
#
# This database is SHARED with justin06lee.dev — both sites read and write the
# same calendar tables, and both run the same idempotent initDb() on cold start.
# Pointing this at a scratch file (TURSO_DATABASE_URL="file:./scratch.db") is
# the way to run the app without touching real data; the schema builds itself
# on the first request.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin password, used by src/lib/auth.ts. Unset disables admin login entirely
# and logs a warning — the site still serves its public pages read-only.
# Guesses are rate-limited per IP: 10 per 15 minutes, then locked out for 24h.
ADMIN_KEY=

# Origin used for canonical URLs, OG tags, robots.txt and the sitemap
# (src/lib/site-url.ts). No trailing slash. Falls back to
# https://hours.justin06lee.dev when unset.
NEXT_PUBLIC_SITE_URL=
